CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
CONFIG_DRAM_CLK=456
CONFIG_SUNXI_NO_PMIC=y
CONFIG_SYS_CLK_FREQ=408000000
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv stdin nulldev"
CONFIG_BOOTCOMMAND="echo FRAMELOG-START; ums 0 mmc 1; echo FRAMELOG-UMS-EXIT; dcache off; icache off; go 0xffff0020"
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000
CONFIG_CMD_CACHE=y
CONFIG_WDT=y
CONFIG_WDT_SUNXI=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=16000
