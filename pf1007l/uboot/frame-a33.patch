diff --git a/arch/arm/mach-sunxi/dram_sun8i_a33.c b/arch/arm/mach-sunxi/dram_sun8i_a33.c
index 0d08b6a4..bb638d93 100644
--- a/arch/arm/mach-sunxi/dram_sun8i_a33.c
+++ b/arch/arm/mach-sunxi/dram_sun8i_a33.c
@@ -280,6 +280,16 @@ static int mctl_channel_init(struct dram_para *para)
 			return -EIO;
 	}
 done:
+	/*
+	 * PF1007L frame: byte lane 0 comes out of reset disabled, so the low
+	 * byte reads back as zero. Mirror lane 1's config onto it and retrain.
+	 */
+	if (para->bus_width == 16 && !(readl(DXnGCR0(0)) & 0x1)) {
+		writel(readl(DXnGCR0(1)), DXnGCR0(0));
+		if (mctl_train_dram(para) != 0)
+			return -EIO;
+	}
+
 	/* Check the dramc status */
 	mctl_await_completion(&mctl_ctl->statr, 0x1, 0x1);
 
